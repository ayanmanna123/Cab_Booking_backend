# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Configuration
# Found in Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication (Clerk / Supabase / Custom JWT)
# Clerk Secret Key from Clerk Dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# Stripe Payments Configuration
# From Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Map & Geolocation Provider: Leaflet + OpenStreetMap + OSRM
# 100% Free & Open-Source (No Google Maps API Key or billing required)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
